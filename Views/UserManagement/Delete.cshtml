@model CrudApplication.Models.Entities.User
@{
    ViewBag.Title = "Delete User";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">Delete User</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>Warning!</strong> Are you sure you want to delete this user?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Name:</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Email:</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Phone:</dt>
                        <dd class="col-sm-8">@(Model.PhoneNumber != null ? Model.PhoneNumber : "N/A")</dd>
                    </dl>

                    @using (Html.BeginForm("Delete", "UserManagement", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", Model.UserId)

                        <div class="d-flex justify-content-between mt-4">
                            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
                            <button type="submit" class="btn btn-danger">Delete User</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>