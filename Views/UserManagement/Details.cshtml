@model CrudApplication.Models.Entities.User
@{
    ViewBag.Title = "User Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">User Details</h3>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">User ID:</dt>
                        <dd class="col-sm-8">@Model.UserId</dd>

                        <dt class="col-sm-4">Name:</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Email:</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Phone Number:</dt>
                        <dd class="col-sm-8">@(Model.PhoneNumber != null ? Model.PhoneNumber : "N/A")</dd>

                        <dt class="col-sm-4">Age:</dt>
                        <dd class="col-sm-8">@(Model.Age.HasValue ? Model.Age.Value.ToString() : "N/A")</dd>

                        <dt class="col-sm-4">Gender:</dt>
                        <dd class="col-sm-8">@(Model.Gender != null ? Model.Gender : "N/A")</dd>

                        <dt class="col-sm-4">Skills:</dt>
                        <dd class="col-sm-8">@(Model.Skills != null ? Model.Skills : "N/A")</dd>

                        <dt class="col-sm-4">Education:</dt>
                        <dd class="col-sm-8">@(Model.Education != null ? Model.Education : "N/A")</dd>

                        <dt class="col-sm-4">Address:</dt>
                        <dd class="col-sm-8">@(Model.Address != null ? Model.Address : "N/A")</dd>

                        <dt class="col-sm-4">Created Date:</dt>
                        <dd class="col-sm-8">@Model.CreatedDate.ToString("MMMM dd, yyyy hh:mm tt")</dd>

                        <dt class="col-sm-4">Last Updated:</dt>
                        <dd class="col-sm-8">@(Model.UpdatedDate.HasValue ? Model.UpdatedDate.Value.ToString("MMMM dd, yyyy hh:mm tt") : "Never")</dd>

                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </dd>
                    </dl>

                    <div class="d-flex justify-content-between mt-4">
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                        <div>
                            @Html.ActionLink("Edit", "Edit", new { id = Model.UserId }, new { @class = "btn btn-warning" })
                            @Html.ActionLink("Delete", "Delete", new { id = Model.UserId }, new { @class = "btn btn-danger" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
