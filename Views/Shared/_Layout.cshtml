<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - User Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .navbar {
            box-shadow: 0 2px 4px rgba(0,0,0,.1);
        }

        .card {
            border: none;
            border-radius: 10px;
        }

        .btn {
            border-radius: 5px;
        }

        footer {
            margin-top: 50px;
            padding: 20px 0;
            background-color: #343a40;
            color: white;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <i class="fas fa-users-cog"></i> User Management System
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (Session["UserId"] != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Dashboard", "Home")">
                                <i class="fas fa-home"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link">Welcome, @Session["UserName"]</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Logout", "Account")">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </a>
                        </li>
                    }
                    else if (Session["AdminId"] != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "UserManagement")">
                                <i class="fas fa-users"></i> Manage Users
                            </a>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link">Admin: @Session["AdminEmail"]</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Logout", "Admin")">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login", "Account")">
                                <i class="fas fa-sign-in-alt"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Register", "Account")">
                                <i class="fas fa-user-plus"></i> Register
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login", "Admin")">
                                <i class="fas fa-shield-alt"></i> Admin
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
    </div>

    <footer class="text-center">
        <div class="container">
            <p>&copy; @DateTime.Now.Year - User Management System. All rights reserved.</p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

<!-- ============================================= -->
<!-- Views/Home/Index.cshtml -->
<!-- ============================================= -->
@{
    ViewBag.Title = "Home";
}

<div class="container">
    <div class="text-center mt-5">
        <h1 class="display-4">Welcome to User Management System</h1>
        <p class="lead">A complete ASP.NET Framework application with Entity Framework 6</p>

        <div class="row mt-5">
            <div class="col-md-4">
                <div class="card shadow mb-4">
                    <div class="card-body text-center">
                        <i class="fas fa-user-plus fa-3x text-primary mb-3"></i>
                        <h4>User Registration</h4>
                        <p>Create a new user account with comprehensive details</p>
                        @Html.ActionLink("Register Now", "Register", "Account", null, new { @class = "btn btn-primary" })
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow mb-4">
                    <div class="card-body text-center">
                        <i class="fas fa-sign-in-alt fa-3x text-success mb-3"></i>
                        <h4>User Login</h4>
                        <p>Access your account with email or phone number</p>
                        @Html.ActionLink("Login", "Login", "Account", null, new { @class = "btn btn-success" })
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow mb-4">
                    <div class="card-body text-center">
                        <i class="fas fa-shield-alt fa-3x text-danger mb-3"></i>
                        <h4>Admin Panel</h4>
                        <p>Manage all users with full CRUD operations</p>
                        @Html.ActionLink("Admin Login", "Login", "Admin", null, new { @class = "btn btn-danger" })
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-5">
            <h3>Features</h3>
            <div class="row mt-4">
                <div class="col-md-3">
                    <i class="fas fa-lock fa-2x text-info mb-2"></i>
                    <h5>Secure Authentication</h5>
                    <p>Password hashing with ASP.NET Identity</p>
                </div>
                <div class="col-md-3">
                    <i class="fas fa-database fa-2x text-warning mb-2"></i>
                    <h5>Entity Framework 6</h5>
                    <p>Code-first approach with migrations</p>
                </div>
                <div class="col-md-3">
                    <i class="fas fa-mobile-alt fa-2x text-primary mb-2"></i>
                    <h5>Responsive Design</h5>
                    <p>Bootstrap 5 for modern UI</p>
                </div>
                <div class="col-md-3">
                    <i class="fas fa-tasks fa-2x text-success mb-2"></i>
                    <h5>Complete CRUD</h5>
                    <p>Full user management system</p>
                </div>
            </div>
        </div>
    </div>
</div>