@model CrudApplication.Models.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Admin Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0 text-center">Admin Login</h3>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("Login", "Admin", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            @Html.TextBoxFor(m => m.EmailOrPhone, new { @class = "form-control", placeholder = "Enter admin email", type = "email" })
                            @Html.ValidationMessageFor(m => m.EmailOrPhone, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter password" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg">Login as Admin</button>
                        </div>

                        <div class="text-center mt-3">
                            <p>@Html.ActionLink("Back to User Login", "Login", "Account")</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}